  <widget class="QGroupBox" name="groupBox_4">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>280</y>
     <width>638</width>
     <height>315</height>
    </rect>
   </property>
   <property name="title">
    <string>Example :</string>
   </property>
   <widget class="QPlainTextEdit" name="plainTextEdit">
    <property name="geometry">
     <rect>
      <x>10</x>
      <y>25</y>
      <width>618</width>
      <height>280</height>
     </rect>
    </property>
    <property name="lineWrapMode">
     <enum>QPlainTextEdit::NoWrap</enum>
    </property>
    <property name="readOnly">
     <bool>true</bool>
    </property>
    <property name="plainText">
     <string># --- PDF vers PNG : transform = list_pdf, path = dossier des PDF, path_out = dossier de sortie
list_pdf

# --- Conversion de format
Convert | out = png
Convert | out = dcm
Convert | out = tif | invert = 1

# --- Contraste 16 vers 8 bits (spec générée par le viewer xf xray)
Transform | Min(%) = 2 | Max(%) = 98 | Mode = Sigmoide
Transform | Min (I16) = 59221 | Max (I16) = 65535 | Mode = CLAHE | HE bins = 256 | CLAHE clip = 0.010

# --- Recadrage (zone à partir d'un coin haut-gauche)
Crop | line = 10 | col = 20 | delta_line = 300 | delta_col = 400
# En % : line/delta_line en % de la hauteur, col/delta_col en % de la largeur (décimales OK)
Crop | line(%) = 10 | col(%) = 20 | delta_line(%) = 50 | delta_col(%) = 60
# Recadrage centré : un fichier par centre (sortie_0001, sortie_0002...)
Crop | col = 38 89 | line = 33 33 | delta_line = 30 | delta_col = 30 | type = center
# Taille en % possible (centres toujours en pixels, px et % mélangeables)
Crop | col = 38 89 | line = 33 33 | delta_line(%) = 10 | delta_col(%) = 15 | type = center

# --- Redimensionnement (width seul ou height seul : ratio conservé)
Resize | width = 512 | height = 256 | interpolation = bilinear
Resize | width = 512
Resize | scale = 0.5

# --- Annotations (value = 255 en 8 bits, 65535 en 16 bits)
Draw | col = 50 49 | line = 59 15 | type = cross
Draw | col = 50 49 | line = 59 15 | type = invcross
Draw | line = 238 | col = 65 | delta_line = 512 | delta_col = 188 | type = rectangle
Write | col = 50 | line = 100 | text = HELLO 123 | size = 2 | value = 255
# Write en % : col(%) de la largeur, line(%) de la hauteur, size(%) = hauteur du texte
Write | col(%) = 5 | line(%) = 90 | text = OK | size(%) = 4 | value = 255

# --- Chaînes : appliquées de gauche à droite, Transform toujours en premier
# Les valeurs en % portent sur l'image courante (ex. après un Crop : l'image recadrée)
Crop | line = 10 | col = 20 | delta_line = 300 | delta_col = 400 | Resize | width = 200
Draw | line = 238 | col = 65 | delta_line = 512 | delta_col = 188 | type = rectangle | Draw | line = 237 | col = 245 | delta_line = 512 | delta_col = 188 | type = rectangle
Transform | Min(%) = 2 | Max(%) = 98 | Mode = Sigmoide | Resize | scale = 0.5 | Write | col = 5 | line = 5 | text = TEST | value = 255</string>
    </property>
   </widget>
  </widget>
